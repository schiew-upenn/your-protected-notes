DATABASE_URL=            # Neon connection string (the project that also hosts Neon Auth)
NEON_AUTH_URL=           # Neon console -> Settings -> Better Auth -> Auth URL (ADR-0003)
PUBLIC_URL=              # this server's own URL, e.g. https://<your-service>.onrender.com
                         # (must be on Neon Auth's trusted domains; localhost works if "Allow Localhost" is on)
